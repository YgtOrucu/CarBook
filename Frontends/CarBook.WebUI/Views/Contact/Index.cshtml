@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('/carbook-master/images/bg_3.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-start">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs">
                    <span class="mr-2"><a href="#">Ana Sayfa <i class="ion-ios-arrow-forward"></i></a></span>
                    <span>İletişim <i class="ion-ios-arrow-forward"></i></span>
                </p>
                <h1 class="mb-3 bread">Bize Ulaşın</h1>
            </div>
        </div>
    </div>
</section>
@await Component.InvokeAsync("SuccessAndErrorMessages")
<section class="ftco-section contact-section">
    <div class="container">
        <div class="row d-flex mb-5 contact-info">
            <div class="col-md-4">
                @await Component.InvokeAsync("AddressSectionInContact")
            </div>
                @await Component.InvokeAsync("SendMessage")
        </div>
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div id="map" class="bg-white"></div>
            </div>
        </div>
    </div>
</section>