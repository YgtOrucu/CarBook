@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("CarBookAdminHead")
<body>
    <div id="layout-wrapper">
        @await Component.InvokeAsync("CarBookAdminNavbar")
        @await Component.InvokeAsync("CarBookAdminSidebar")
        <div class="main-content">

            <div class="page-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
            @await Component.InvokeAsync("CarBookAdminFooter")
        </div>
    </div>
    @await Component.InvokeAsync("CarBookAdminScript")
</body>
</html>