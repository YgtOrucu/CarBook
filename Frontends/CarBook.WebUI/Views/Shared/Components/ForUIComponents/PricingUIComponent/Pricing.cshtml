@model List<ResultCarPricingDto>

<section class="ftco-section ftco-cart">
    <div class="container">
        <div class="row">
            <div class="col-md-12 ftco-animate">
                <div class="car-list">
                    <table class="table">
                        <thead class="thead-primary">
                            <tr class="text-center">
                                <th>&nbsp;</th>
                                <th>&nbsp;</th>
                                <th class="bg-primary heading">Saatlik Ücret</th>
                                <th class="bg-dark heading">Günlük Ücret</th>
                                <th class="bg-dark heading">Haftalık Ücret</th>
                                <th class="bg-black heading">Aylık Ücret</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr class="">
                                    <td class="car-image"><div class="img" style="background-image:url(@item.CoverImageUrl);"></div></td>
                                    <td class="product-name">
                                        <h3>@item.Model</h3>
                                        <p class="mb-0 rated">
                                            <span>Puan:</span>
                                            <span class="ion-ios-star"></span>
                                            <span class="ion-ios-star"></span>
                                            <span class="ion-ios-star"></span>
                                            <span class="ion-ios-star"></span>
                                            <span class="ion-ios-star"></span>
                                        </p>
                                    </td>
                                    @foreach (var carprices in item.CarPriceRates!)
                                    {
                                        <td class="price">
                                            <p class="btn-custom"><a href="#">Kirala</a></p>
                                            <div class="price-rate">
                                                <h3>
                                                    <span class="num"><small class="currency">₺</small> @carprices.Amount.ToString("N2")</span>
                                                    <span class="per">/@carprices.Name</span>
                                                </h3>
                                            </div>
                                        </td>
                                    }

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>