@model List<GetCommentByBlogIdDto>

<h3 class="mb-5">@Model.Count Yorum</h3>
<ul class="comment-list">
    @foreach (var item in Model)
    {
        <li class="comment">
            <div class="vcard bio">
                <img src="@item.ImageUrl" style="height:50px;" alt="Image placeholder">
            </div>
            <div class="comment-body">
                <h3>@item.NameSurname</h3>
                <div class="meta">@item.CreatedDate.ToString("dd MMM yyyy HH:mm")</div>
                <p>@item.MessageBody</p>
                <p><a href="#" class="reply">Reply</a></p>
            </div>
        </li>
    }
</ul>