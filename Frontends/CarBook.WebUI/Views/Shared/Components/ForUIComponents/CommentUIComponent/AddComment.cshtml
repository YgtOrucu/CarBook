@model AddCommmentDto

<div class="comment-form-wrap pt-5">
    <h3 class="mb-5">Bir Yorum Bırakın</h3>

    <form asp-area="Users" asp-controller="Comment" asp-action="AddComment" method="post" class="p-5 bg-light">

        <input type="hidden" asp-for="BlogId" />
        <input type="hidden" asp-for="NameSurname" />

        <div class="form-group">
            <label for="MessageBody">Yorumunuz *</label>
            <textarea asp-for="MessageBody" id="MessageBody" cols="30" rows="6" class="form-control" maxlength="700" required></textarea>
            <small class="form-text text-muted">Maksimum 700 karakter girebilirsiniz.</small>
        </div>

        <div class="form-group">
            <input type="submit" value="Yorum Yap" class="btn py-3 px-4 btn-primary">
        </div>

    </form>
</div>