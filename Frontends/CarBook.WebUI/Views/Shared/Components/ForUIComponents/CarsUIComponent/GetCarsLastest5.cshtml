@model List<ResultCarLastest5Dto>

<section class="ftco-section ftco-no-pt bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 heading-section text-center ftco-animate mb-5">
                <span class="subheading">Sizin İçin Seçtiklerimiz</span>
                <h2 class="mb-2">Öne Çıkan Araçlar</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="carousel-car owl-carousel">
                    @foreach (var item in Model)
                    {
                        <div class="item">
                            <div class="car-wrap rounded ftco-animate">
                                <div class="img rounded d-flex align-items-end" style="background-image: url(@item.CoverImageUrl);">
                                </div>
                                <div class="text">
                                    <h2 class="mb-0"><a href="#">@item.Model</a></h2>
                                    <div class="d-flex mb-3">
                                        <span class="cat">@item.BrandName</span>
                                        <p class="price ml-auto">@item.CarAmount.ToString("N2") ₺ <span>/@item.CarPricingName</span></p>
                                    </div>
                                    <p class="d-flex mb-0 d-block">
                                        <a href="#" class="btn btn-primary py-2 mr-1">Hemen Kirala</a>
                                        <a asp-area="Users" asp-controller="Car" asp-action="CarDetails" asp-route-id="@item.Id" class="btn btn-secondary py-2 ml-1">Detaylar</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>