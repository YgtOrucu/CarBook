@model SendMessageDto

<div class="col-md-8 block-9 mb-md-5">
    <form asp-area="Users" asp-controller="Contact" asp-action="SendMessage" class="bg-light p-5 contact-form">
        <div class="form-group">
            <input type="text" asp-for="@Model.Name" class="form-control" placeholder="Adınız" value="@ViewBag.Name">
        </div>
        <div class="form-group">
            <input type="text" asp-for="@Model.Email" class="form-control" placeholder="Mail Adresi" value="@ViewBag.Email">
        </div>
        <div class="form-group">
            <input type="text" asp-for="@Model.Subject" class="form-control" placeholder="Konu">
        </div>
        <div class="form-group">
            <textarea asp-for="@Model.Message" cols="30" rows="7" class="form-control" placeholder="Mesaj"></textarea>
        </div>
        <div class="form-group">
            <input type="submit" value="Gönder" class="btn btn-primary py-3 px-5">
        </div>
    </form>
</div>