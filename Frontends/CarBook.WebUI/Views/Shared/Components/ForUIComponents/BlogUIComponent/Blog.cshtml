@model List<ResultBlogDto>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<section class="ftco-section">
    <div class="container">
        <div class="row d-flex justify-content-center">
            @foreach (var item in Model)
            {
                <div class="col-md-10 text-center d-flex ftco-animate">
                    <div class="blog-entry justify-content-end mb-md-5">
                        <a asp-area="Users" asp-controller="Blog" asp-action="BlogDetail" asp-route-id="@item.Id" class="block-20 img" style="background-image: url('@item.CoverImageUrl'); height: 500px;">
                        </a>
                        <div class="text px-md-5 pt-4">
                            <div class="meta mb-3">
                                <div><a href="#">@item.CreatedDate.ToString("dd MMM yyyy")</a></div>
                                <div><a href="#">@item.AuthorName</a></div>
                            </div>
                            <h3 class="heading mt-2"><a href="#">@item.Title</a></h3>
                            <p>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    @(item.Description.Length > 300 ? item.Description.Substring(0, 300) + "..." : item.Description)
                                }
                            </p>
                            <p><a asp-area="Users" asp-controller="Blog" asp-action="BlogDetail" asp-route-id="@item.Id" class="btn btn-primary">Devamını Oku <span class="icon-long-arrow-right"></span></a></p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="row mt-5">
                <div class="col text-center">
                    <div class="block-27">
                        <ul>
                            @if (currentPage > 1)
                            {
                                <li>
                                    <a asp-area="Users" asp-controller="Blog" asp-action="Index" asp-route-page="@(currentPage - 1)">&lt;</a>
                                </li>
                            }
                            else
                            {
                                <li class="disabled"><span>&lt;</span></li>
                            }

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="@(i == currentPage ? "active" : "")">
                                    @if (i == currentPage)
                                    {
                                        <span>@i</span>
                                    }
                                    else
                                    {
                                        <a asp-area="Users" asp-controller="Blog" asp-action="Index" asp-route-page="@i">@i</a>
                                    }
                                </li>
                            }

                            @if (currentPage < totalPages)
                            {
                                <li>
                                    <a asp-area="Users" asp-controller="Blog" asp-action="Index" asp-route-page="@(currentPage + 1)">&gt;</a>
                                </li>
                            }
                            else
                            {
                                <li class="disabled"><span>&gt;</span></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</section>