@model CreateReservationDto

<style>
    .request-form select option {
        color: #000 !important;
        background-color: #fff !important;
    }

    .request-form select {
        color: #fff;
    }
</style>


@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <div class="modal fade show" id="customAlertModal" tabindex="-1" role="dialog" style="display: block; background-color: rgba(0, 0, 0, 0.5); z-index: 99999;" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content text-center p-4 shadow-lg" style="border-radius: 16px; border: none;">
                <div class="modal-body p-3">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="mb-3">
                            <div style="width: 70px; height: 70px; background-color: #e8f5e9; color: #28a745; font-size: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%;">
                                ✓
                            </div>
                        </div>
                        <h4 class="font-weight-bold mb-3" style="color: #222;">İşlem Başarılı!</h4>
                        <p class="text-muted mb-4" style="font-size: 15px;">@TempData["SuccessMessage"]</p>
                        <button type="button" class="btn btn-success px-5 py-2 font-weight-bold" style="border-radius: 25px; background-color: #28a745; border: none;" onclick="closeModal()">Tamam</button>
                    }
                    else if (TempData["ErrorMessage"] != null)
                    {
                        <div class="mb-3">
                            <div style="width: 70px; height: 70px; background-color: #ffebee; color: #dc3545; font-size: 30px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%;">
                                ✕
                            </div>
                        </div>
                        <h4 class="font-weight-bold mb-3" style="color: #222;">Hata Oluştu!</h4>
                        <p class="text-muted mb-4" style="font-size: 15px;">@TempData["ErrorMessage"]</p>
                        <button type="button" class="btn btn-danger px-5 py-2 font-weight-bold" style="border-radius: 25px; background-color: #dc3545; border: none;" onclick="closeModal()">Tekrar Deneyin</button>
                    }

                </div>
            </div>
        </div>
    </div>

}
<section class="ftco-section ftco-no-pt bg-light">
    <div class="container">
        <div class="row no-gutters">
            <div class="col-md-12 featured-top">
                <div class="row no-gutters">
                    <div class="col-md-4 d-flex align-items-center">
                        <form asp-controller="Car" asp-action="RentACar" method="post" class="request-form ftco-animate bg-primary">
                            <h2>Yolculuğunuzu Planlayın</h2>
                            <div class="form-group">
                                <label for="PickUpLocation" class="label">Alış Yeri</label>
                                <select asp-for="PickUpLocationId" class="form-control form-select" required>
                                    <option value="">-- Alış Yeri Seçiniz --</option>
                                    @if (ViewBag.PickUpLocation != null)
                                    {
                                        @foreach (var location in (List<GetLocationDropdownDto>)ViewBag.PickUpLocation)
                                        {
                                            <option value="@location.Id">@location.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="DropOffLocation" class="label">İade Yeri</label>
                                <select asp-for="DropOffLocationId" class="form-control form-select" required>
                                    <option value="">-- İade Yeri Seçiniz --</option>
                                    @if (ViewBag.DropOffLocation != null)
                                    {
                                        @foreach (var location in (List<GetLocationDropdownDto>)ViewBag.DropOffLocation)
                                        {
                                            <option value="@location.Id">@location.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="CarId" class="label">Araç Seçimi</label>
                                <select asp-for="CarId" id="carSelect" class="form-control form-select" style="color:white" required>
                                    <option value="" data-image="">-- Araç ve Model Seçiniz --</option>
                                    @if (ViewBag.Car != null)
                                    {
                                        @foreach (var car in (List<GetCarDropdownDto>)ViewBag.Car)
                                        {
                                            <option value="@car.Id">
                                                @car.BrandName - @car.Model
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="d-flex">
                                <div class="form-group mr-2">
                                    <label asp-for="PickUpDate" class="label">Alış Tarihi</label>
                                    <input type="text" asp-for="PickUpDate" class="form-control" id="book_pick_date" placeholder="Tarih">
                                </div>
                                <div class="form-group ml-2">
                                    <label asp-for="DropOffDate" class="label">İade Tarihi</label>
                                    <input type="text" asp-for="DropOffDate" class="form-control" id="book_off_date" placeholder="Tarih">
                                </div>
                            </div>

                            <div class="d-flex">
                                <div class="form-group mr-2 w-50">
                                    <label asp-for="PickUpTime" class="label">Alış Saati</label>
                                    <input type="text" asp-for="PickUpTime" class="form-control time_pick" placeholder="Saat">
                                </div>
                                <div class="form-group ml-2 w-50">
                                    <label asp-for="DropOffTime" class="label">İade Saati</label>
                                    <input type="text" asp-for="DropOffTime" class="form-control time_pick" placeholder="Saat">
                                </div>
                            </div>

                            <div class="form-group">
                                <input type="submit" value="Hemen Araç Kirala" class="btn btn-secondary py-3 px-4">
                            </div>
                        </form>
                    </div>

                    <div class="col-md-8 d-flex align-items-center">
                        <div class="services-wrap rounded-right w-100">
                            <h3 class="heading-section mb-4">Mükemmel Aracınızı Kiralamanın En İyi Yolu</h3>
                            <div class="row d-flex mb-4">
                                <div class="col-md-4 d-flex align-self-stretch ftco-animate">
                                    <div class="services w-100 text-center">
                                        <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-route"></span></div>
                                        <div class="text w-100">
                                            <h3 class="heading mb-2">Alış Noktanızı Seçin</h3>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 d-flex align-self-stretch ftco-animate">
                                    <div class="services w-100 text-center">
                                        <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-handshake"></span></div>
                                        <div class="text w-100">
                                            <h3 class="heading mb-2">En İyi Teklifi Seçin</h3>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 d-flex align-self-stretch ftco-animate">
                                    <div class="services w-100 text-center">
                                        <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-rent"></span></div>
                                        <div class="text w-100">
                                            <h3 class="heading mb-2">Kiralık Aracınızı Ayırın</h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <p><a href="#" class="btn btn-primary py-3 px-4">Mükemmel Aracınızı Ayırın</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function closeModal() {
        var modal = document.getElementById('customAlertModal');
        if (modal) {
            modal.style.display = 'none';
        }
    }
</script>