<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar bg-dark ftco-navbar-light" id="ftco-navbar">
    <div class="container">
        <a class="navbar-brand" asp-area="Users" asp-controller="HomePage" asp-action="Index">Car<span>Book</span></a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav" aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="oi oi-menu"></span> Menü
        </button>

        <div class="collapse navbar-collapse" id="ftco-nav">
            <ul class="navbar-nav ml-auto align-items-center">
                <li class="nav-item"><a asp-area="Users" asp-controller="HomePage" asp-action="Index" class="nav-link">Ana Sayfa</a></li>
                <li class="nav-item"><a asp-area="Users" asp-controller="About" asp-action="Index" class="nav-link">Hakkımızda</a></li>
                <li class="nav-item"><a asp-area="Users" asp-controller="Service" asp-action="Index" class="nav-link">Hizmetler</a></li>
                <li class="nav-item"><a asp-area="Users" asp-controller="Pricing" asp-action="Index" class="nav-link">Fiyatlandırma</a></li>
                <li class="nav-item"><a asp-area="Users" asp-controller="Car" asp-action="Index" class="nav-link">Araçlar</a></li>
                <li class="nav-item"><a asp-area="Users" asp-controller="Blog" asp-action="Index" class="nav-link">Blog</a></li>
                <li class="nav-item"><a asp-area="Users" asp-controller="Contact" asp-action="Index" class="nav-link">İletişim</a></li>

                @if (Model.IsAuthenticated)
                {
                    <li class="nav-item ml-md-3 dropdown d-flex align-items-center">
                        <a class="profile-chip d-flex align-items-center py-1 pl-1 pr-3 rounded-pill text-decoration-none dropdown-toggle-no-caret"
                           href="#"
                           id="userProfileDropdown"
                           role="button"
                           data-toggle="dropdown"
                           aria-haspopup="true"
                           aria-expanded="false">

                            <div class="profile-avatar-wrapper mr-2">
                                <div class="profile-avatar text-white font-weight-bold d-flex align-items-center justify-content-center rounded-circle">
                                    @Model.Initials
                                </div>
                                <span class="status-dot"></span>
                            </div>

                            <div id="userInfo" class="d-none d-lg-block text-left mr-2">
                                <div class="name">@Model.DisplayName</div>
                                <div class="role">@Model.RoleName</div>
                            </div>

                            <i class="fas fa-chevron-down chevron-icon"></i>
                        </a>

                        <div class="dropdown-menu dropdown-menu-right custom-dropdown-menu mt-3 p-2"
                             aria-labelledby="userProfileDropdown">

                            <div class="dropdown-header d-lg-none">
                                <div class="header-avatar">@Model.Initials</div>
                                <div>
                                    <div class="name">@Model.DisplayName</div>
                                    <small class="role">@Model.RoleName</small>
                                </div>
                            </div>

                            <a class="dropdown-item custom-dropdown-item"
                               asp-area="Users" asp-controller="Account" asp-action="MyReservations">
                                <span class="item-icon icon-blue"><i class="fas fa-car"></i></span>
                                <span>Rezervasyonlarım</span>
                            </a>

                            <a class="dropdown-item custom-dropdown-item"
                               asp-area="Users" asp-controller="Account" asp-action="MyReviews">
                                <span class="item-icon icon-amber"><i class="fas fa-star"></i></span>
                                <span>Yorumlarım</span>
                            </a>

                            <a class="dropdown-item custom-dropdown-item"
                               asp-area="Users" asp-controller="Account" asp-action="MyProfile">
                                <span class="item-icon icon-cyan"><i class="fas fa-user-cog"></i></span>
                                <span>Hesabım</span>
                            </a>

                            <div class="custom-dropdown-divider"></div>

                            <a class="dropdown-item custom-dropdown-item logout-item"
                               asp-area="" asp-controller="Auth" asp-action="Logout">
                                <span class="item-icon icon-red"><i class="fas fa-sign-out-alt"></i></span>
                                <span>Çıkış Yap</span>
                            </a>
                        </div>
                    </li>
                }
                else
                {
                    <li class="nav-item cta ml-md-2">
                        <a asp-area="" asp-controller="Auth" asp-action="Login" class="nav-link btn btn-login-cta px-4 py-2 rounded-pill text-white">
                            <i class="fas fa-user mr-2"></i> Giriş Yap
                        </a>
                    </li>
                }

            </ul>
        </div>
    </div>
</nav>