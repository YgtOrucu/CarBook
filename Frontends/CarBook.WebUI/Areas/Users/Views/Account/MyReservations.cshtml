@model List<GetLoginUsersReservation>
@{
    ViewData["PageTitle"] = "Rezervasyonlarım";
    ViewData["PageBreadcrumb"] = "Rezervasyonlarım";
    ViewData["PageBgUrl"] = "/carbook-master/images/bg_3.jpg";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<partial name="_PageHeaderPartial" />

<section class="res-section">
    <div class="res-container">

        @if (Model == null || !Model.Any())
        {
            <div class="res-empty">
                <i class="fas fa-car-side"></i>
                <h4>Henüz bir rezervasyonunuz yok</h4>
                <p>Hemen bir araç seçin, yolculuğunuza bugün başlayın.</p>
                <a asp-area="Users" asp-controller="HomePage" asp-action="Index">Araçları İncele</a>
            </div>
        }
        else
        {
            var items = Model.Select(r =>
            {
                var statusText = r.Status.ToString();
                string statusClass = "status-pending";
                string statusLabel = "Beklemede";
                string category = "ongoing";
                bool canUpdate = false;
                bool canCancel = false;

                switch (statusText)
                {
                    case "Pending":
                        statusClass = "status-pending";
                        statusLabel = "Beklemede";
                        canUpdate = true;
                        canCancel = true;
                        category = r.DropOffDate.Date < DateTime.Today ? "past" : "ongoing";
                        break;
                    case "Approved":
                        statusClass = "status-approved";
                        statusLabel = "Onaylandı";
                        canUpdate = false;
                        canCancel = true;
                        category = r.DropOffDate.Date < DateTime.Today ? "past" : "ongoing";
                        break;
                    case "Cancelled":
                        statusClass = "status-cancelled";
                        statusLabel = "İptal Edildi";
                        category = "cancelled";
                        break;
                    case "Completed":
                        statusClass = "status-completed";
                        statusLabel = "Tamamlandı";
                        category = "completed";
                        break;
                    case "Rejected":
                        statusClass = "status-rejected";
                        statusLabel = "Reddedildi";
                        category = "cancelled";
                        break;
                }

                return new
                {
                    Reservation = r,
                    StatusClass = statusClass,
                    StatusLabel = statusLabel,
                    CanUpdate = canUpdate,
                    CanCancel = canCancel,
                    Category = category
                };
            }).ToList();

            var countAll = items.Count;
            var countOngoing = items.Count(x => x.Category == "ongoing");
            var countPast = items.Count(x => x.Category == "past");
            var countCompleted = items.Count(x => x.Category == "completed");
            var countCancelled = items.Count(x => x.Category == "cancelled");

            <div class="res-layout">
                <aside class="res-sidebar">
                    <div class="res-sidebar-title">Rezervasyonlarım</div>

                    <button type="button" class="res-sidebar-item active" data-filter="all">
                        <i class="fas fa-layer-group"></i>
                        <span>Tümü</span>
                        <span class="res-count">@countAll</span>
                    </button>

                    <button type="button" class="res-sidebar-item" data-filter="ongoing">
                        <i class="fas fa-hourglass-half"></i>
                        <span>Devam Eden</span>
                        <span class="res-count">@countOngoing</span>
                    </button>

                    <button type="button" class="res-sidebar-item" data-filter="past">
                        <i class="fas fa-history"></i>
                        <span>Geçmiş</span>
                        <span class="runes-cot">@countPast</span>
                    </button>
                    
                    <button type="button" class="res-sidebar-item" data-filter="completed">
                        <i class="fas fa-check-circle"></i>
                        <span>Gerçekleşen</span>
                        <span class="res-count">@countCompleted</span>
                    </button>

                    <button type="button" class="res-sidebar-item" data-filter="cancelled">
                        <i class="fas fa-ban"></i>
                        <span>İptal Edilen</span>
                        <span class="res-count">@countCancelled</span>
                    </button>
                </aside>

                <div class="res-main">
                    @foreach (var item in items)
                    {
                        var reservation = item.Reservation;
                        var statusClass = item.StatusClass;
                        var statusLabel = item.StatusLabel;
                        var canUpdate = item.CanUpdate;
                        var canCancel = item.CanCancel;

                        <div class="res-card"
                             data-category="@item.Category"
                             data-id="@reservation.Id"
                             data-carname="@reservation.CarName"
                             data-pickuplocation="@reservation.PickUpLocationName"
                             data-dropofflocation="@reservation.DropOffLocationName"
                             data-pickupdate="@reservation.PickUpDate.ToString("yyyy-MM-dd")"
                             data-dropoffdate="@reservation.DropOffDate.ToString("yyyy-MM-dd")"
                             data-pickuptime="@reservation.PickUpTime.ToString(@"hh\:mm")"
                             data-dropofftime="@reservation.DropOffTime.ToString(@"hh\:mm")">

                            <div class="res-card-top">
                                <div class="res-car-info">
                                    <div class="res-car-icon"><i class="fas fa-car"></i></div>
                                    <div>
                                        <h5>@reservation.CarName</h5>
                                        <span>Rezervasyon #@reservation.Id</span>
                                    </div>
                                </div>
                                <span class="res-status-badge @statusClass">@statusLabel</span>
                            </div>

                            <div class="res-card-body">
                                <div class="res-info-item">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <div>
                                        <div class="label">Alış Noktası</div>
                                        <div class="value">@reservation.PickUpLocationName</div>
                                    </div>
                                </div>
                                <div class="res-info-item">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <div>
                                        <div class="label">Bırakış Noktası</div>
                                        <div class="value">@reservation.DropOffLocationName</div>
                                    </div>
                                </div>
                                <div class="res-info-item">
                                    <i class="fas fa-calendar-check"></i>
                                    <div>
                                        <div class="label">Alış Tarihi &amp; Saati</div>
                                        <div class="value">@reservation.PickUpDate.ToString("dd.MM.yyyy") &middot; @reservation.PickUpTime.ToString(@"hh\:mm")</div>
                                    </div>
                                </div>
                                <div class="res-info-item">
                                    <i class="fas fa-calendar-times"></i>
                                    <div>
                                        <div class="label">Bırakış Tarihi &amp; Saati</div>
                                        <div class="value">@reservation.DropOffDate.ToString("dd.MM.yyyy") &middot; @reservation.DropOffTime.ToString(@"hh\:mm")</div>
                                    </div>
                                </div>
                                <div class="res-info-item">
                                    <i class="fas fa-money-bill-wave"></i>
                                    <div>
                                        <div class="label">Toplam Fiyat</div>
                                        <div class="value">@reservation.Price.ToString("N0") ₺</div>
                                    </div>
                                </div>
                            </div>

                            <div class="res-card-actions">
                                @if (canUpdate)
                                {
                                    <button type="button" class="btn-res btn-res-update" onclick="openUpdateModal(this)">
                                        <i class="fas fa-pen"></i> Güncelle
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn-res btn-res-disabled" disabled title="Bu rezervasyon artık güncellenemez">
                                        <i class="fas fa-pen"></i> Güncelle
                                    </button>
                                }

                                @if (canCancel)
                                {
                                    <button type="button" class="btn-res btn-res-cancel" onclick="openCancelModal(@reservation.Id)">
                                        <i class="fas fa-times"></i> İptal Et
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div class="res-empty-filtered" id="resEmptyFiltered" style="display:none;">
                        <i class="fas fa-folder-open"></i>
                        <h4 style="color:#2E3A46; font-weight:700; margin-bottom:6px;">Bu kategoride rezervasyon bulunamadı</h4>
                        <p style="margin:0;">Farklı bir filtre seçerek diğer rezervasyonlarınıza göz atabilirsiniz.</p>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

<div class="res-modal-overlay" id="updateModalOverlay">
    <div class="res-modal">
        <h4><i class="fas fa-pen text-primary"></i> Rezervasyonu Güncelle</h4>
        <p class="res-modal-sub" id="updateModalCarName">Araç bilgisi</p>

        <form id="updateReservationForm">
            <input type="hidden" id="updateResId" name="Id" />

            <div class="res-form-row">
                <div class="res-form-group">
                    <label>Alış Tarihi</label>
                    <input type="date" id="updatePickUpDate" name="PickUpDate" required />
                </div>
                <div class="res-form-group">
                    <label>Alış Saati</label>
                    <input type="time" id="updatePickUpTime" name="PickUpTime" required />
                </div>
            </div>

            <div class="res-form-row">
                <div class="res-form-group">
                    <label>Bırakış Tarihi</label>
                    <input type="date" id="updateDropOffDate" name="DropOffDate" required />
                </div>
                <div class="res-form-group">
                    <label>Bırakış Saati</label>
                    <input type="time" id="updateDropOffTime" name="DropOffTime" required />
                </div>
            </div>

            <div class="res-modal-actions">
                <button type="button" class="btn-modal-cancel" onclick="closeUpdateModal()">Vazgeç</button>
                <button type="submit" class="btn-modal-confirm">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<div class="res-modal-overlay" id="cancelModalOverlay">
    <div class="res-modal">
        <h4><i class="fas fa-triangle-exclamation text-danger"></i> Rezervasyonu İptal Et</h4>
        <p class="res-modal-sub">Bu rezervasyonu iptal etmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>

        <div class="res-modal-actions">
            <button type="button" class="btn-modal-cancel" onclick="closeCancelModal()">Vazgeç</button>
            <button type="button" class="btn-modal-confirm danger" id="confirmCancelBtn">Evet, İptal Et</button>
        </div>
    </div>
</div>

<div class="res-toast" id="resToast">
    <i class="fas fa-check-circle"></i>
    <span id="resToastText">İşlem başarılı</span>
</div>

