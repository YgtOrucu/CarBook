@using System.IdentityModel.Tokens.Jwt
@{
    ViewData["Title"] = "İletişim";
    ViewData["PageTitle"] = "Bize Ulaşın";
    ViewData["PageBreadcrumb"] = "İletişim";
    ViewData["PageBgUrl"] = "/carbook-master/images/bg_3.jpg";
    Layout = "~/Views/UILayout/Index.cshtml";
    var isAuthenticated = User?.Identity != null && User.Identity.IsAuthenticated;
    var Name = isAuthenticated ? (User?.FindFirst("FullName")?.Value ?? "Kullanıcı") : null;
    var Email = isAuthenticated ? (User?.FindFirst(JwtRegisteredClaimNames.Email)?.Value ?? null) : null;
}
<partial name="_PageHeaderPartial" />
@await Component.InvokeAsync("SuccessAndErrorMessages")
<section class="ftco-section contact-section">
    <div class="container">
        <div class="row d-flex mb-5 contact-info">
            <div class="col-md-4">
                @await Component.InvokeAsync("AddressSectionInContact")
            </div>
            @await Component.InvokeAsync("SendMessage", new { Name = Name, Email = Email })
        </div>
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div id="map" class="bg-white"></div>
            </div>
        </div>
    </div>
</section>