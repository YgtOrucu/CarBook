@{
    var title = ViewData["PageTitle"] ?? "CarBook";
    var breadcrumb = ViewData["PageBreadcrumb"] ?? title;
    var bgUrl = ViewData["PageBgUrl"] ?? "/carbook-master/images/bg_3.jpg";
}

<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('@bgUrl');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-start">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs">
                    <span class="mr-2"><a href="/">Ana Sayfa <i class="ion-ios-arrow-forward"></i></a></span>
                    <span>@breadcrumb <i class="ion-ios-arrow-forward"></i></span>
                </p>
                <h1 class="mb-3 bread">@title</h1>
            </div>
        </div>
    </div>
</section>