@model List<ResultSocialMediaDto>
@{
    ViewData["PageTitle"] = "Sosyal Medya Yönetimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-share-2 text-primary mr-2"></i>Sosyal Medya Hesapları Listesi
                </h5>
                <a href="/Admin/SocialMedia/CreateSocialMedia" class="btn btn-sm btn-primary btn-rounded shadow-sm">
                    <i class="mdi mdi-plus mr-1"></i> Yeni Sosyal Medya Hesabı Ekle
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-centered table-nowrap mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width: 50px;">#</th>
                                <th class="text-center" style="width: 70px;">İkon</th>
                                <th>Platform Adı</th>
                                <th>Bağlantı (URL)</th>
                                <th class="text-center" style="width: 150px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model.Where(x => !x.IsDeleted))
                                {
                                    count++;
                                    <tr>
                                        <td class="text-center font-weight-bold">@count</td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.Icon) && item.Icon.StartsWith("<i"))
                                            {
                                                @Html.Raw(item.Icon)
                                            }
                                            else
                                            {
                                                <i class="@(string.IsNullOrEmpty(item.Icon) ? "feather-share-2" : item.Icon) font-size-20 text-primary"></i>
                                            }
                                        </td>
                                        <td>
                                            <span class="font-weight-semibold text-dark">@item.Name</span>
                                        </td>
                                        <td>
                                            <a href="@item.Url" target="_blank" class="text-info font-weight-medium text-truncate d-inline-block" style="max-width: 350px;">
                                                <i class="feather-external-link mr-1 font-size-12"></i>@item.Url
                                            </a>
                                        </td>
                                        <td class="text-center">
                                            <a href="/Admin/SocialMedia/UpdateSocialMedia/@item.Id" class="btn btn-sm btn-soft-warning waves-effect waves-light mr-1" data-toggle="tooltip" title="Düzenle">
                                                <i class="mdi mdi-pencil font-size-16"></i>
                                            </a>
                                            <a href="/Admin/SocialMedia/RemoveSocialMedia/@item.Id" onclick="return confirm('Bu sosyal medya hesabını silmek istediğinize emin misiniz?')" class="btn btn-sm btn-soft-danger waves-effect waves-light" data-toggle="tooltip" title="Sil">
                                                <i class="mdi mdi-trash-can font-size-16"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="mdi mdi-alert-circle-outline font-size-20 mr-1 align-middle"></i> Henüz bir sosyal medya hesabı tanımlanmadı.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>