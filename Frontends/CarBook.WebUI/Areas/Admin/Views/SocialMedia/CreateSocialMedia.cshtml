@model CreateSocialMediaDto
@{
    ViewData["PageTitle"] = "Yeni Sosyal Medya Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-plus-circle text-primary mr-2"></i>Yeni Sosyal Medya Tanımlama
                </h5>
                <a href="/Admin/SocialMedia/Index" class="btn btn-sm btn-soft-secondary btn-rounded shadow-sm">
                    <i class="mdi mdi-arrow-left mr-1"></i> Listeye Dön
                </a>
            </div>

            <div class="card-body">
                <form method="post" action="/Admin/SocialMedia/CreateSocialMedia">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Platform Adı</label>
                                <input type="text" asp-for="Name" class="form-control" placeholder="Örn: Instagram, LinkedIn, Twitter" required />
                                <span asp-validation-for="Name" class="text-danger font-size-12"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">İkon Sınıfı</label>
                                <input type="text" asp-for="Icon" class="form-control" placeholder="Örn: mdi mdi-instagram veya fa fa-instagram" required />
                                <span asp-validation-for="Icon" class="text-danger font-size-12"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Sosyal Medya Linki (URL)</label>
                                <input type="url" asp-for="Url" class="form-control" placeholder="https://instagram.com/carbook" required />
                                <span asp-validation-for="Url" class="text-danger font-size-12"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <a href="/Admin/SocialMedia/Index" class="btn btn-light waves-effect mr-2">İptal</a>
                        <button type="submit" class="btn btn-primary waves-effect waves-light shadow-sm">
                            <i class="mdi mdi-content-save mr-1"></i> Hesabı Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>