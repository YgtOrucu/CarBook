@model List<ResultTestimonialDto>
@{
    ViewData["PageTitle"] = "Müşteri Yorumları";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-smile text-primary mr-2"></i>Müşteri Yorum & Referans Listesi
                </h5>
                <a href="/Admin/Testimonial/CreateTestimonial" class="btn btn-sm btn-primary btn-rounded shadow-sm">
                    <i class="mdi mdi-plus mr-1"></i> Yeni Yorum Ekle
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-centered table-nowrap mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width: 50px;">#</th>
                                <th>Müşteri</th>
                                <th>Unvan / Meslek</th>
                                <th>Yorum İçeriği</th>
                                <th class="text-center" style="width: 150px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model.Where(x => !x.IsDeleted))
                                {
                                    count++;
                                    <tr>
                                        <td class="text-center font-weight-bold">@count</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ImageUrl" alt="client-img" class="rounded-circle mr-2 shadow-sm" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src='/carbook-admin/assets/images/users/avatar-1.jpg'">
                                                <span class="font-weight-semibold text-dark">@item.Name</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge badge-soft-info font-size-12 p-2">@item.Title</span>
                                        </td>
                                        <td>
                                            <p class="text-muted mb-0 text-truncate" style="max-width: 320px;" title="@item.Comment">
                                                @item.Comment
                                            </p>
                                        </td>
                                        <td class="text-center">
                                            <a href="/Admin/Testimonial/UpdateTestimonial/@item.Id" class="btn btn-sm btn-soft-warning waves-effect waves-light mr-1" data-toggle="tooltip" title="Düzenle">
                                                <i class="mdi mdi-pencil font-size-16"></i>
                                            </a>
                                            <a href="/Admin/Testimonial/RemoveTestimonial/@item.Id" onclick="return confirm('Bu müşteri yorumunu silmek istediğinize emin misiniz?')" class="btn btn-sm btn-soft-danger waves-effect waves-light" data-toggle="tooltip" title="Sil">
                                                <i class="mdi mdi-trash-can font-size-16"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="mdi mdi-alert-circle-outline font-size-20 mr-1 align-middle"></i> Henüz bir müşteri yorumu kaydı bulunamadı.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>