@model CreateTestimonialDto
@{
    ViewData["PageTitle"] = "Yeni Müşteri Yorumu Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-plus-circle text-primary mr-2"></i>Yeni Müşteri Yorumu Tanımlama
                </h5>
                <a href="/Admin/Testimonial/Index" class="btn btn-sm btn-soft-secondary btn-rounded shadow-sm">
                    <i class="mdi mdi-arrow-left mr-1"></i> Listeye Dön
                </a>
            </div>

            <div class="card-body">
                <form method="post" action="/Admin/Testimonial/CreateTestimonial">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Müşteri Adı Soyadı</label>
                                <input type="text" asp-for="Name" class="form-control" placeholder="Örn: Ahmet Yılmaz" required />
                                <span asp-validation-for="Name" class="text-danger font-size-12"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Unvan / Şirket / Meslek</label>
                                <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Yazılım Mühendisi, CEO" required />
                                <span asp-validation-for="Title" class="text-danger font-size-12"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Müşteri Profil Görsel URL</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                                <span asp-validation-for="ImageUrl" class="text-danger font-size-12"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Müşteri Yorumu</label>
                                <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Müşterinin deneyimi ve yorum metni..." required></textarea>
                                <span asp-validation-for="Comment" class="text-danger font-size-12"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <a href="/Admin/Testimonial/Index" class="btn btn-light waves-effect mr-2">İptal</a>
                        <button type="submit" class="btn btn-primary waves-effect waves-light shadow-sm">
                            <i class="mdi mdi-content-save mr-1"></i> Yorumu Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>