@model ResultBannerDto
@{
    ViewData["PageTitle"] = "Banner Yönetimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-image text-primary mr-2"></i>Aktif Banner Bilgileri
                </h5>

                @if (Model != null)
                {
                    <a href="/Admin/Banner/UpdateBanner/@Model.Id" class="btn btn-sm btn-warning waves-effect waves-light shadow-sm text-white">
                        <i class="mdi mdi-pencil mr-1"></i> Banner'ı Düzenle
                    </a>
                }
                else
                {
                    <a href="/Admin/Banner/CreateBanner" class="btn btn-sm btn-primary btn-rounded shadow-sm">
                        <i class="mdi mdi-plus mr-1"></i> Yeni Banner Ekle
                    </a>
                }
            </div>

            <div class="card-body">
                @if (Model != null)
                {
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-4">
                                <h6 class="text-muted text-uppercase font-size-12 font-weight-bold">Banner Başlığı</h6>
                                <h4 class="text-dark font-weight-semibold">@Model.Title</h4>
                            </div>

                            <div class="mb-4">
                                <h6 class="text-muted text-uppercase font-size-12 font-weight-bold">Banner Açıklaması</h6>
                                <p class="text-secondary font-size-15" style="line-height: 1.6;">
                                    @Model.Description
                                </p>
                            </div>

                            <div class="mb-3">
                                <h6 class="text-muted text-uppercase font-size-12 font-weight-bold">Video Bağlantısı</h6>
                                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                                {
                                    <a href="@Model.VideoUrl" target="_blank" class="btn btn-sm btn-soft-danger waves-effect waves-light mt-1">
                                        <i class="mdi mdi-youtube mr-1 font-size-16 align-middle"></i> Tanıtım Videosunu İzle
                                    </a>
                                    <span class="d-block text-muted font-size-12 mt-1">@Model.VideoUrl</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary">Ekli video bulunmuyor</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-4 d-flex align-items-center justify-content-center border-left">
                            <div class="text-center p-3">
                                <div class="avatar-lg mx-auto mb-3">
                                    <span class="avatar-title rounded-circle bg-soft-primary text-primary font-size-24">
                                        <i class="feather-image"></i>
                                    </span>
                                </div>
                                <p class="text-muted font-size-13">Bu içerik ana sayfanızın en üstündelle yer alan karşılama (Hero/Banner) alanında aktif olarak görüntülenmektedir.</p>

                                <a href="/Admin/Banner/RemoveBanner/@Model.Id" onclick="return confirm('Mevcut banner kaydını silmek istediğinize emin misiniz?')" class="btn btn-sm btn-soft-danger waves-effect mt-2">
                                    <i class="mdi mdi-trash-can mr-1"></i> Banner'ı Sil
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="mdi mdi-alert-circle-outline text-warning display-4"></i>
                        <h5 class="mt-3 text-dark">Henüz Bir Banner Tanımlanmamış</h5>
                        <p class="text-muted">Ana sayfada görünecek karşılama alanını oluşturmak için yeni bir banner ekleyebilirsiniz.</p>
                        <a href="/Admin/Banner/CreateBanner" class="btn btn-primary waves-effect waves-light mt-2">
                            <i class="mdi mdi-plus mr-1"></i> Banner Ekle
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>