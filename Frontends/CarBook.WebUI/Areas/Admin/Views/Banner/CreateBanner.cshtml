@model CreateBannerDto
@{
    ViewData["PageTitle"] = "Yeni Banner Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-plus-circle text-primary mr-2"></i>Yeni Banner Tanımlama
                </h5>
                <a href="/Admin/Banner/Index" class="btn btn-sm btn-soft-secondary btn-rounded shadow-sm">
                    <i class="mdi mdi-arrow-left mr-1"></i> Listeye Dön
                </a>
            </div>

            <div class="card-body">
                <form method="post" action="/Admin/Banner/CreateBanner">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Banner Başlığı</label>
                                <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Hızlı Ve Kolay Araç Kiralama" required />
                                <span asp-validation-for="Title" class="text-danger font-size-12"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Video URL (YouTube vb.)</label>
                                <input type="text" asp-for="VideoUrl" class="form-control" placeholder="Örn: https://www.youtube.com/watch?v=..." />
                                <span asp-validation-for="VideoUrl" class="text-danger font-size-12"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Banner Açıklaması</label>
                                <textarea asp-for="Description" rows="4" class="form-control" placeholder="Banner alanında görünecek kısa alt metni giriniz..."></textarea>
                                <span asp-validation-for="Description" class="text-danger font-size-12"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <a href="/Admin/Banner/Index" class="btn btn-light waves-effect mr-2">İptal</a>
                        <button type="submit" class="btn btn-primary waves-effect waves-light shadow-sm">
                            <i class="mdi mdi-content-save mr-1"></i> Banner Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>