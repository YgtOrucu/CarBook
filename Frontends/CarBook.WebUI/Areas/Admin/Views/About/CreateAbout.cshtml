@model CreateAboutDto
@{
    ViewData["PageTitle"] = "Yeni Hakkımızda İçeriği Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-8 col-lg-10 mx-auto">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-plus-circle text-primary mr-2"></i>Yeni Hakkımızda Bilgisi
                </h5>
                <a href="/Admin/About/Index/" class="btn btn-sm btn-soft-secondary btn-rounded waves-effect">
                    <i class="mdi mdi-arrow-left mr-1"></i> Listeye Dön
                </a>
            </div>

            <div class="card-body p-4">
                <form asp-area="Admin" asp-controller="About" asp-action="CreateAbout" method="post">

                    <div class="form-group mb-3">
                        <label class="font-weight-semibold text-dark">Başlık</label>
                        <input type="text" asp-for="Title" class="form-control rounded-lg" placeholder="Örn: Sektörde Güven, Yolda Konfor: CarBook" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label class="font-weight-semibold text-dark">Görsel URL</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-light border-right-0"><i class="mdi mdi-image-outline"></i></span>
                            </div>
                            <input type="text" asp-for="ImageUrl" class="form-control border-left-0 rounded-right-lg" placeholder="https://domain.com/gorsel.jpg" required />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label class="font-weight-semibold text-dark">Açıklama / Metin</label>
                        <textarea asp-for="Description" class="form-control rounded-lg" rows="6" placeholder="Hakkımızda detaylı açıklama metnini giriniz..." required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-end">
                        <a href="/Admin/About/Index/" class="btn btn-light waves-effect mr-2">İptal</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm waves-effect waves-light">
                            <i class="mdi mdi-check-circle mr-1"></i> Kaydet
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>