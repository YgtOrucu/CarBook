@model CreateCarDto
@{
    ViewData["PageTitle"] = "Yeni Araç Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-plus-circle text-primary mr-2"></i>Yeni Araç Tanımla
                </h5>
                <a href="/Admin/Car/Index" class="btn btn-sm btn-outline-secondary btn-rounded">
                    <i class="mdi mdi-arrow-left mr-1"></i> Listeye Dön
                </a>
            </div>

            <div class="card-body">
                <form asp-action="CreateCar" method="post">
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-semibold text-dark">Marka</label>
                            <select asp-for="BrandId" class="form-control form-select" required>
                                <option value="">-- Marka Seçiniz --</option>
                                @if (ViewBag.BrandValues != null)
                                {
                                    @foreach (var brand in (List<ResultBrandDto>)ViewBag.BrandValues)
                                    {
                                        <option value="@brand.Id">@brand.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-semibold text-dark">Model</label>
                            <input type="text" asp-for="Model" class="form-control" placeholder="Örn: Corolla, Civic" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 form-group mb-3">
                            <label class="font-weight-semibold text-dark">Vites Tipi</label>
                            <select asp-for="Transmission" class="form-control form-select">
                                <option value="1">Otomatik</option>
                                <option value="2">Yarı Otomatik</option>
                                <option value="3">Manuel</option>
                            </select>
                        </div>
                        <div class="col-md-4 form-group mb-3">
                            <label class="font-weight-semibold text-dark">Yakıt Tipi</label>
                            <select asp-for="Fuel" class="form-control form-select">
                                <option value="Benzin">Benzin</option>
                                <option value="Dizel">Dizel</option>
                                <option value="Hibrit">Hibrit</option>
                                <option value="Elektrik">Elektrik</option>
                            </select>
                        </div>
                        <div class="col-md-4 form-group mb-3">
                            <label class="font-weight-semibold text-dark">Kilometre (KM)</label>
                            <input type="number" asp-for="CarKM" class="form-control" placeholder="0" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-semibold text-dark">Koltuk Sayısı</label>
                            <input type="number" asp-for="SeatCount" class="form-control" placeholder="5" required />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-semibold text-dark">Bagaj Kapasitesi (Adet)</label>
                            <input type="number" asp-for="LuggageCount" class="form-control" placeholder="2" required />
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="font-weight-semibold text-dark">Kapak Görsel URL</label>
                        <input type="text" asp-for="CoverImageUrl" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="form-group mb-4">
                        <label class="font-weight-semibold text-dark">Büyük Görsel URL</label>
                        <input type="text" asp-for="BigImageUrl" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="text-right">
                        <a href="/Admin/Car/Index" class="btn btn-light mr-2">İptal</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="mdi mdi-check mr-1"></i> Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>