@model CreateFooterAddressDto
@{
    ViewData["PageTitle"] = "Yeni Adres Bilgisi Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-plus-circle text-primary mr-2"></i>Yeni Footer Adres Bilgisi Tanımlama
                </h5>
                <a href="/Admin/FooterAddress/Index" class="btn btn-sm btn-soft-secondary btn-rounded shadow-sm">
                    <i class="mdi mdi-arrow-left mr-1"></i> Listeye Dön
                </a>
            </div>

            <div class="card-body">
                <form method="post" action="/Admin/FooterAddress/CreateFooterAddress">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Telefon Numarası</label>
                                <input type="text" asp-for="Phone" class="form-control" placeholder="Örn: +90 541 125 45 22" required />
                                <span asp-validation-for="Phone" class="text-danger font-size-12"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">E-Posta Adresi</label>
                                <input type="email" asp-for="Email" class="form-control" placeholder="Örn: info@carbook.com" required />
                                <span asp-validation-for="Email" class="text-danger font-size-12"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Açık Adres</label>
                                <input type="text" asp-for="Address" class="form-control" placeholder="Örn: Ebuziya Caddesi, Port Rezidans İstanbul" required />
                                <span asp-validation-for="Address" class="text-danger font-size-12"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label class="font-weight-semibold text-dark">Alt Bilgi Açıklaması</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Footer alanında yer alacak kısa tanıtım metni..." required></textarea>
                                <span asp-validation-for="Description" class="text-danger font-size-12"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <a href="/Admin/FooterAddress/Index" class="btn btn-light waves-effect mr-2">İptal</a>
                        <button type="submit" class="btn btn-primary waves-effect waves-light shadow-sm">
                            <i class="mdi mdi-content-save mr-1"></i> Adres Bilgisini Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>