@model List<ResultAuthorDto>
@{
    ViewData["PageTitle"] = "Yazarlarımız";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-info text-primary mr-2"></i>Yazar İçerik Listesi
                </h5>         
                <a href="/Admin/Author/CreateAuthor/" class="btn btn-sm btn-secondary btn-rounded waves-effect waves-light shadow-sm">
                    <i class="mdi mdi-plus mr-1"></i> Yeni Araç Ekle
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-centered table-nowrap mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width: 50px;">#</th>
                                <th>Resim</th>
                                <th>Yazar Adı</th>
                                <th>Açıklama</th>
                                <th class="text-center" style="width: 150px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td class="text-center font-weight-bold">@count</td>
                                        <td>
                                            <div class="avatar-sm">
                                                <img src="@item.ImageUrl" alt="author-img" class="img-thumbnail rounded-circle shadow-sm" style="width:40px; height:40px; object-fit:cover;" onerror="this.src='/carbook-admin/assets/images/users/avatar-1.jpg'">
                                            </div>
                                        </td>
                                        <td>
                                            <span class="font-weight-semibold text-dark">@item.Name</span>
                                        </td>
                                        <td>
                                            <p class="text-muted mb-0 text-truncate" style="max-width: 350px;" title="@item.Description">
                                                @item.Description
                                            </p>
                                        </td>
                                        <td class="text-center">
                                            <a href="/Admin/Author/UpdateAuthor/@item.Id" class="btn btn-sm btn-soft-warning waves-effect waves-light mr-1" data-toggle="tooltip" title="Düzenle">
                                                <i class="mdi mdi-pencil font-size-16"></i>
                                            </a>
                                            <a href="/Admin/Author/RemoveAuthor/@item.Id" onclick="return confirm('Bu içeriği silmek istediğinize emin misiniz?')" class="btn btn-sm btn-soft-danger waves-effect waves-light" data-toggle="tooltip" title="Sil">
                                                <i class="mdi mdi-trash-can font-size-16"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="mdi mdi-alert-circle-outline font-size-20 mr-1 align-middle"></i> Henüz bir kayıt bulunamadı.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>