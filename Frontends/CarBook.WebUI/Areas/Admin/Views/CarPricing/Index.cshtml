@model List<ResultCarPricingWithTimePeriodDto>
@{
    ViewData["PageTitle"] = "Araç Fiyat Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-dollar-sign text-success mr-2"></i>Araç Fiyat Matrisi
                </h5>
                <a href="/Admin/CarPricing/CreateCarPricing" class="btn btn-sm btn-primary btn-rounded">
                    <i class="feather-plus mr-1"></i> Yeni Fiyat Tanımla
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Görsel</th>
                                <th>Marka & Model</th>
                                <th>Saatlik Ücret</th>
                                <th>Günlük Ücret</th>
                                <th>Haftalık Ücret</th>
                                <th>Aylık Ücret</th>
                                <th class="text-center">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="width: 100px;">
                                            <img src="@item.CoverImageUrl" class="rounded shadow-sm" width="80" height="50" style="object-fit: cover;" />
                                        </td>
                                        <td>
                                            <strong>@item.BrandName</strong> @item.Model
                                        </td>
                                        <td class="text-primary font-weight-bold">₺@item.HourlyAmount.ToString("N2")</td>
                                        <td class="text-success font-weight-bold">₺@item.DailyAmount.ToString("N2")</td>
                                        <td class="text-info font-weight-bold">₺@item.WeeklyAmount.ToString("N2")</td>
                                        <td class="text-dark font-weight-bold">₺@item.MonthlyAmount.ToString("N2")</td>
                                        <td class="text-center">
                                            <a asp-action="UpdateCarPricing"
                                               asp-controller="CarPricing"
                                               asp-area="Admin"
                                               asp-route-carId="@item.CarId"
                                               class="btn btn-sm btn-outline-warning mr-1">
                                                <i class="feather-edit"></i> Düzenle
                                            </a>
                                            <a asp-action="RemoveCarPricing"
                                               asp-controller="CarPricing"
                                               asp-area="Admin"
                                               asp-route-carId="@item.CarId"
                                               class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu araca ait fiyatlandırmaları silmek istediğinize emin misiniz?');">
                                                <i class="feather-trash-2"></i> Sil
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        Henüz tanımlanmış bir araç fiyat bilgisi bulunamadı.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>