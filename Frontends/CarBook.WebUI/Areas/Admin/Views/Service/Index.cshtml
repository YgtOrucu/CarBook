@model List<ResultServiceDto>
@{
    ViewData["PageTitle"] = "Hizmetlerimiz";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-layers text-primary mr-2"></i>Hizmetlerimiz Listesi
                </h5>
                <a href="/Admin/Service/CreateService" class="btn btn-sm btn-primary btn-rounded shadow-sm">
                    <i class="mdi mdi-plus mr-1"></i> Yeni Hizmet Ekle
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-centered table-nowrap mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width: 50px;">#</th>
                                <th style="width: 80px;" class="text-center">İkon</th>
                                <th>Hizmet Başlığı</th>
                                <th>Açıklama</th>
                                <th class="text-center" style="width: 150px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model.Where(x => !x.IsDeleted))
                                {
                                    count++;
                                    <tr>
                                        <td class="text-center font-weight-bold">@count</td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.IconUrl) && item.IconUrl.StartsWith("<i"))
                                            {
                                                @Html.Raw(item.IconUrl)
                                            }
                                            else if (!string.IsNullOrEmpty(item.IconUrl) && (item.IconUrl.StartsWith("http") || item.IconUrl.StartsWith("/")))
                                            {
                                                <img src="@item.IconUrl" alt="icon" style="width:32px; height:32px; object-fit:contain;" />
                                            }
                                            else
                                            {
                                                <i class="@(string.IsNullOrEmpty(item.IconUrl) ? "feather-layers" : item.IconUrl) font-size-22 text-primary"></i>
                                            }
                                        </td>
                                        <td>
                                            <span class="font-weight-semibold text-dark">@item.Title</span>
                                        </td>
                                        <td>
                                            <p class="text-muted mb-0 text-truncate" style="max-width: 380px;" title="@item.Description">
                                                @item.Description
                                            </p>
                                        </td>
                                        <td class="text-center">
                                            <a href="/Admin/Service/UpdateService/@item.Id" class="btn btn-sm btn-soft-warning waves-effect waves-light mr-1" data-toggle="tooltip" title="Düzenle">
                                                <i class="mdi mdi-pencil font-size-16"></i>
                                            </a>
                                            <a href="/Admin/Service/RemoveService/@item.Id" onclick="return confirm('Bu hizmeti silmek istediğinize emin misiniz?')" class="btn btn-sm btn-soft-danger waves-effect waves-light" data-toggle="tooltip" title="Sil">
                                                <i class="mdi mdi-trash-can font-size-16"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="mdi mdi-alert-circle-outline font-size-20 mr-1 align-middle"></i> Henüz tanımlanmış bir hizmet bulunamadı.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>