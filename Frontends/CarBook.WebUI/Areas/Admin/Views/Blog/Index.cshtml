@model List<ResultBlogDto>
@{
    ViewData["PageTitle"] = "Blog Yönetimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<partial name="_PageHeaderAdminPartial" />

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom-0">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="feather-book-open text-primary mr-2"></i>Blog Listesi
                </h5>
                <a href="/Admin/Blog/CreateBlog" class="btn btn-sm btn-primary btn-rounded shadow-sm">
                    <i class="mdi mdi-plus mr-1"></i> Yeni Blog Ekle
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-centered table-nowrap mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width: 50px;">#</th>
                                <th style="width: 80px;" class="text-center">Görsel</th>
                                <th>Blog Başlığı</th>
                                <th>Yazar / Kategori</th>
                                <th>Açıklama</th>
                                <th class="text-center" style="width: 150px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td class="text-center font-weight-bold">@count</td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                            {
                                                <img src="@item.CoverImageUrl" alt="cover" class="rounded" style="width:48px; height:32px; object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <i class="feather-image font-size-22 text-muted"></i>
                                            }
                                        </td>
                                        <td>
                                            <span class="font-weight-semibold text-dark" title="@item.Title">
                                                @(item.Title.Length > 50 ? item.Title.Substring(0, 50) + "..." : item.Title)
                                            </span>
                                        </td>
                                        <td>
                                            <div>
                                                <i class="mdi mdi-account-outline text-muted mr-1"></i>
                                                <span class="font-weight-medium text-dark font-size-13">@item.AuthorName</span>
                                            </div>
                                            <div class="mt-1">
                                                <span class="badge badge-soft-primary px-2 py-1">@item.CategoryName</span>
                                            </div>
                                        </td>
                                        <td>
                                            <p class="text-muted mb-0 text-truncate" style="max-width: 320px;" title="@item.Description">
                                                @(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                            </p>
                                        </td>
                                        <td class="text-center">
                                            <a href="/Admin/Blog/UpdateBlog/@item.Id" class="btn btn-sm btn-soft-warning waves-effect waves-light mr-1" data-toggle="tooltip" title="Düzenle">
                                                <i class="mdi mdi-pencil font-size-16"></i>
                                            </a>
                                            <a href="/Admin/Blog/RemoveBlog/@item.Id" onclick="return confirm('Bu blog yazısını silmek istediğinize emin misiniz?')" class="btn btn-sm btn-soft-danger waves-effect waves-light" data-toggle="tooltip" title="Sil">
                                                <i class="mdi mdi-trash-can font-size-16"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="mdi mdi-alert-circle-outline font-size-20 mr-1 align-middle"></i> Henüz tanımlanmış bir blog yazısı bulunamadı.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>